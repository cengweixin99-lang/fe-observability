{
  "name": "frontend-observability",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:demo": "pnpm --filter @fe-observability/demo-app dev",
    "dev:dashboard": "pnpm --filter @fe-observability/dashboard dev",
    "dev:server": "pnpm --filter @fe-observability/server start:dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}